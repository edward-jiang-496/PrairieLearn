{{#question}}
    <div id="{{name}}-container" class="pl-matching-container pl-matching-container-{{options_placement}}" aria-label="{{aria_label}}" data-answer-name="{{name}}" data-max-response-per-option="{{max_response_per_option}}">
        <div class="pl-matching-statements">
            {{#statements}}
                <div class="pl-matching-statement">
                    <div class="pl-matching-statement-select">
                        <select name="{{name}}" class="form-select" {{^editable}}disabled{{/editable}} aria-labelledby="statement-label-{{statement_id}}">
                            {{#options}}
                                <option 
                                    {{selected}}
                                    value="{{index}}"
                                    {{#blank}}aria-label="Blank"{{/blank}}
                                    {{^no_counters}}{{^blank}}aria-labelledby="pl-matching-{{uuid}}-option-{{value}}-content"{{/blank}}{{/no_counters}}
                                >
                                    {{value}}
                                </option>
                            {{/options}}
                        </select>
                    </div>
                    <div class="pl-matching-statement-text" id="statement-label-{{statement_id}}">
                        {{{html}}}
                    </div>
                    {{#display_score_badge}}
                        <div>
                            {{#correct}}
                                <span class="badge text-bg-success"><i class="fas fa-check" aria-hidden="true"></i></span>
                            {{/correct}}
                            {{^correct}}
                                <span class="badge text-bg-danger"><i class="fas fa-times" aria-hidden="true"></i></span>
                            {{/correct}}
                        </div>
                    {{/display_score_badge}}
                </div>
            {{/statements}}
            
        </div>
        {{^no_counters}}
            <div class="pl-matching-options">
                <ol>
                    {{#options}}
                        <li class="pl-matching-option" style="--pl-matching-counter-type: {{counter_type}}">
                            <span id="pl-matching-{{uuid}}-option-{{counter}}-content">{{{html}}}</span>
                        </li>
                    {{/options}}
                </ol>
            </div>
        {{/no_counters}}
    </div>
    {{#has_max_response_per_option}}
        <div id="{{name}}-max-options-warning" class="pl-matching-max-options-warning text-danger" aria-live="polite" hidden>
            {{max_options_warning_statement}}
        </div>
    {{/has_max_response_per_option}}
    <div class="right-info-column d-flex flex-column align-items-start ps-1">
        {{#show_help_text}}
            <button
                type="button"
                class="btn p-0 border-0 text-dark d-flex align-items-center"
                data-bs-toggle="popover"
                data-bs-html="true"
                title="Matching Input"
                data-bs-content="{{info}}"
                data-bs-placement="auto"
            >
                <i class="fa fa-question-circle" aria-hidden="true"></i>
            </button>
        {{/show_help_text}}
    </div>
    {{#reset_button}}
        <button type="button" class="btn btn-outline-secondary btn-sm pl-matching-reset-btn" data-answers-name="{{name}}">
            Reset Above Dropdown
        </button>
    {{/reset_button}}
    <div>
        {{#correct}}<span class="badge text-bg-success"><i class="fas fa-check" aria-hidden="true"></i> 100%</span>{{/correct}}
        {{#partial}}<span class="badge text-bg-warning"><i class="far fa-circle" aria-hidden="true"></i> {{partial}}%</span>{{/partial}}
        {{#incorrect}}<span class="badge text-bg-danger"><i class="fas fa-times" aria-hidden="true"></i> 0%</span>{{/incorrect}}
    </div>
{{/question}}

{{#submission}}
    <div class="d-flex" aria-label="{{aria_label}}">
        <div class="pl-matching-statements">
            {{#statements}}
                <div class="pl-matching-statement">
                    <div class="pl-matching-answer">
                        <strong>{{counter}}</strong> {{{option}}}
                    </div>
                    <div class="pl-matching-statement-text">
                        {{{statement}}}
                    </div>
                    {{#parse_error}}
                    <span class="small" style="white-space: nowrap">
                        <span class="badge text-bg-danger">
                            Invalid <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
                        </span>
                        <a
                            class="link-primary"
                            tabindex="0"
                            role="button"
                            data-bs-placement="auto"
                            data-bs-toggle="popover"
                            data-bs-html="true"
                            title="Format error"
                            data-bs-content="{{parse_error}}"
                        >
                        More info…
                        </a>
                    </span>
                    {{/parse_error}}
                    {{#display_score_badge}}
                    <div>
                        {{#correct}}
                            <span class="badge text-bg-success"><i class="fas fa-check" aria-hidden="true"></i></span>
                        {{/correct}}
                        {{^correct}}
                            <span class="badge text-bg-danger"><i class="fas fa-times" aria-hidden="true"></i></span>
                        {{/correct}}
                    </div>
                    {{/display_score_badge}}
                </div>
            {{/statements}}
        </div>
    </div>
{{/submission}}

{{#answer}}
    <div class="d-flex" aria-label="{{aria_label}}">
        <div class="pl-matching-statements">
            {{#statements}}
                <div class="pl-matching-statement">
                    <div class="pl-matching-answer">
                        <strong>{{counter}}</strong> {{{option}}}
                    </div>
                    <div class="pl-matching-statement-text">
                        {{{statement}}}
                    </div>
                </div>
            {{/statements}}
        </div>
    </div>
{{/answer}}
{{#format}}
    <p>{{grading_text}}</p>
{{/format}}
